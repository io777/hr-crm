@model List<Position>
@{
    ViewData["Title"] = "Должности";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Должности</h4>
    <a href="/Positions/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добавить
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover bg-white">
        <thead class="table-light">
            <tr>
                <th>Должность</th>
                <th>Оклад</th>
                <th>Сотрудников</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Title</td>
                    <td>@(p.BaseSalary?.ToString("N0") ?? "—") ₽</td>
                    <td><span class="badge bg-primary">@p.Employees.Count</span></td>
                    <td>
                        <form method="post" asp-action="Delete" asp-route-id="@p.Id"
                              class="d-inline" onsubmit="return confirm('Удалить должность?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-1"></i>
        <p>Должности не найдены</p>
    </div>
}
