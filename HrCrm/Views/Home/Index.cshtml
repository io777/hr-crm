@{
    ViewData["Title"] = "Главная";
}

<h4 class="mb-4">Панель управления</h4>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">Всего сотрудников</h6>
                        <h2 class="mb-0">@ViewBag.EmployeeCount</h2>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="/Employees" class="text-white">Перейти →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">Активных</h6>
                        <h2 class="mb-0">@ViewBag.ActiveCount</h2>
                    </div>
                    <i class="bi bi-person-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1">Отделов</h6>
                        <h2 class="mb-0">@ViewBag.DepartmentCount</h2>
                    </div>
                    <i class="bi bi-building fs-1 opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="/Departments" class="text-white">Перейти →</a>
            </div>
        </div>
    </div>
</div>
